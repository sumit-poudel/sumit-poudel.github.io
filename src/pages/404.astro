---
import Layout from '../layouts/Layout.astro';
---

<Layout title="No Such Buffer">
  <div class="h-screen grid grid-cols-3">
    <div class="col-start-2 flex items-center justify-center">
      <div class="text-center">
        <h1 class="text-3xl font-bold mb-4 text-nvim-blue">E492: Not an editor command</h1>
        <p class="text-lg mb-2">No such buffer.</p>
        <p class="text-lg">The page you asked for is not in this file.</p>
        <p class="mt-4 text-nvim-gray">Use <span class="text-nvim-blue">:q</span> to close the tab.</p>
      </div>
    </div>
  </div>
</Layout>
