---
import Layout from "../layouts/Layout.astro";
---

<Layout title="astro-vim-landing">
  <div class="flex flex-col items-center justify-center h-full">
    <h1 class="text-4xl font-bold mb-8 text-nvim-blue">sumit-poudel</h1>
    <div class="text-center">
      <p class="mb-4">version 1.0.0 (Arch/CachyOS)</p>
      <p class="mb-2">Go & Web Engineer | Open Source Maintainer <a class="mb-4 hover:underline text-nvim-blue" href="https://github.com/b0sc">@b0sc</a></p>
      <a href="https://github.com/sumit-poudel" class="mb-4 hover:underline block text-nvim-blue">github.com/sumit-poudel</a>

      <div class="p-8 text-nvim-green text-left inline-block">
        <a href="/about" class="block hover:underline">
          <p>type  :about<span class="text-nvim-blue">&lt;Enter&gt;</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;to view stack &amp; bio</p>
        </a>
        <a href="/projects" class="block hover:underline">
          <p>type  :projects<span class="text-nvim-blue">&lt;Enter&gt;</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;to view builds (datastar-lsp, oWtE, Subha Fertility)</p>
        </a>
        <a href="/blog" class="block hover:underline">
          <p>type  :blog<span class="text-nvim-blue">&lt;Enter&gt;</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;to view articles &amp; guides</p>
        </a>
        <a href="/contact" class="block hover:underline">
          <p>type  :contact<span class="text-nvim-blue">&lt;Enter&gt;</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;to view email &amp; socials</p>
        </a>
        <br />
        <p>type  /<span class="text-nvim-blue">&lt;Search term&gt;</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;to search posts, <span class="text-nvim-blue">#tags</span> &amp; recent searches</p>
        <br />
        <a href="/help" class="block hover:underline">
          <p>type  :h<span class="text-nvim-blue">&lt;Enter&gt;</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;to view the help page</p>
        </a>
        <a href="/exited" class="block hover:underline">
          <p>type  :q<span class="text-nvim-blue">&lt;Enter&gt;</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;to exit</p>
        </a>
      </div>
    </div>
  </div>
</Layout>
