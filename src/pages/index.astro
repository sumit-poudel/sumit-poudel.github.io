---
import Layout from "../layouts/Layout.astro";
import { AUTHOR, personSchema, websiteSchema } from "../consts";

const site = Astro.site ?? new URL("https://www.sumit-poudel.com.np");

const commands = [
  { cmd: ':about', hint: 'to view stack & bio', href: '/about' },
  { cmd: ':projects', hint: 'to view builds (datastar-lsp, oWtE, Subha Fertility)', href: '/projects' },
  { cmd: ':blog', hint: 'to view articles & guides', href: '/blog' },
  { cmd: ':contact', hint: 'to view email & socials', href: '/contact' },
  { cmd: ':h', hint: 'to view the help page', href: '/help' },
  { cmd: ':q', hint: 'to exit', href: '/exited' },
];

const pad = '<span class="hidden sm:inline">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>';
---

<Layout
  title={`${AUTHOR.name} — Go & Web Engineer, Open Source Maintainer`}
  description={`${AUTHOR.name} is a ${AUTHOR.jobTitle} and open source maintainer from Chitwan, Nepal — building with Go, Neovim, Astro and Linux (Arch/CachyOS).`}
  schema={[personSchema(site), websiteSchema(site)]}
>
  <div class="flex min-h-full flex-col items-center justify-center py-4 sm:py-0">
    <h1 class="mb-4 text-3xl font-bold text-nvim-blue sm:mb-8 sm:text-4xl">sumit-poudel</h1>
    <div class="w-full max-w-full text-center">
      <p class="mb-4 break-words">version 1.0.0 (Arch/CachyOS)</p>
      <p class="mb-2 break-words">Go & Web Engineer | Open Source Maintainer <a class="hover:underline text-nvim-blue" href="https://github.com/b0sc">@b0sc</a></p>
      <a href="https://github.com/sumit-poudel" class="mb-4 block break-all hover:underline text-nvim-blue">github.com/sumit-poudel</a>

      <div class="w-full p-2 text-left text-nvim-green sm:inline-block sm:w-auto sm:p-8">
        {commands.slice(0, 4).map(({ cmd, hint, href }) => (
          <a href={href} class="block hover:underline">
            <p class="break-words">type&nbsp; {cmd}<span class="text-nvim-blue">&lt;Enter&gt;</span><Fragment set:html={pad} /> {hint}</p>
          </a>
        ))}
        <br />
        <p class="break-words">
          type&nbsp; /<span class="text-nvim-blue">&lt;Search term&gt;</span><Fragment set:html={pad} /> to search posts, <span class="text-nvim-blue">#tags</span> &amp; recent searches
        </p>
        <br />
        {commands.slice(4).map(({ cmd, hint, href }) => (
          <a href={href} class="block hover:underline">
            <p class="break-words">type&nbsp; {cmd}<span class="text-nvim-blue">&lt;Enter&gt;</span><Fragment set:html={pad} /> {hint}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
