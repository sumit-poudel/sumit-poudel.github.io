---
import Layout from '../layouts/Layout.astro';
import { AUTHOR, SITE, breadcrumbSchema, personSchema } from '../consts';

const site = Astro.site ?? new URL('https://www.sumit-poudel.com.np');

const trail = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about/' },
];

const profile = {
  ...personSchema(site),
  description: `${AUTHOR.jobTitle} and open source maintainer, currently a BCA student at Birendra Multiple Campus and web engineer at BOSC.`,
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Birendra Multiple Campus',
    url: 'https://bimc.tu.edu.np/',
  },
  worksFor: { '@type': 'Organization', name: 'BOSC', url: 'https://bosc.org.np/' },
};
---

<Layout
  title={`About — ${AUTHOR.name}, ${AUTHOR.jobTitle}`}
  description={`${AUTHOR.name} is a ${AUTHOR.jobTitle} and open source maintainer based in Chitwan, Nepal, working with Go, Neovim and Linux.`}
  schema={[profile, breadcrumbSchema(site, trail)]}
>
  <div class="max-w-3xl">
    <h1 class="text-2xl font-bold text-nvim-blue">{AUTHOR.name}</h1>
    <p class="mt-1 text-nvim-green">version 1.0.0 (Arch/CachyOS)</p>

    <div class="mt-6 flex flex-col gap-4">
      <p>
        I'm <a href="https://github.com/sumit-poudel/" target="_blank" rel="noopener noreferrer" class="text-nvim-blue hover:underline">sumit poudel</a>,
        a Go &amp; web engineer and open source maintainer. Most of my day is spent in the terminal on Arch, with Neovim open.
      </p>
      <p>
        I'm a student at <a href="https://bimc.tu.edu.np/" target="_blank" rel="noopener noreferrer" class="text-nvim-blue hover:underline">Birendra Multiple Campus</a>,
        currently in the BCA program, and I work as the web engineer for the open source club
        <a href="https://bosc.org.np/" target="_blank" rel="noopener noreferrer" class="text-nvim-blue hover:underline">BOSC</a>.
      </p>
      <p>
        I'm passionate about learning anything that looks cool and fun. The current penguins hate me
        because of my ex NVIDIA, and I've never looked back.
      </p>
    </div>

    <h2 class="mt-8 text-lg font-bold text-nvim-blue">Stack</h2>
    <ul class="mt-2 flex flex-col gap-1 text-nvim-gray">
      <li>Go, TypeScript</li>
      <li>Astro, React, Next.js, Tailwind CSS</li>
      <li>PostgreSQL, Java, C</li>
      <li>Neovim, Linux (Arch &amp; CachyOS), Hyprland</li>
      <li>I use Arch btw</li>
    </ul>

    <h2 class="mt-8 text-lg font-bold text-nvim-blue">Currently</h2>
    <ul class="mt-2 flex flex-col gap-1 text-nvim-gray">
      <li>Building <a href="https://github.com/sumit-poudel/datastar-lsp" target="_blank" rel="noopener noreferrer" class="text-nvim-blue hover:underline">datastar-lsp</a>, a language server for DataStar written in Go</li>
      <li>Web engineer at BOSC, previously built the site for the Subha Fertility clinic</li>
      <li>Published my first AUR package, <a href="https://github.com/sumit-poudel/oWtE" target="_blank" rel="noopener noreferrer" class="text-nvim-blue hover:underline">oWtE</a></li>
      <li>Writing about it all on <a href="/blog">:blog</a></li>
    </ul>
  </div>
</Layout>
