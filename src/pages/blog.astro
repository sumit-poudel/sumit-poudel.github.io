---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE, breadcrumbSchema, personSchema } from '../consts';

const blogPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const site = Astro.site ?? new URL('https://www.sumit-poudel.com.np');
const description = `Writing about Neovim, Go, Linux and the tools I break along the way — ${blogPosts.length} posts on Hyprland, Arch/CachyOS, hackathons and open source.`;

const trail = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
];

const itemList = {
  '@type': 'ItemList',
  '@id': new URL('/blog/', site).href + '#list',
  name: 'Blog',
  numberOfItems: blogPosts.length,
  itemListElement: blogPosts.map((post, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/blog/${post.id}`, site).href,
    name: post.data.title,
  })),
};
---

<Layout
  title={`Blog — Neovim, Go & Linux Notes | ${SITE.owner}`}
  description={description}
  schema={[itemList, breadcrumbSchema(site, trail), personSchema(site)]}
>
  <header class="mb-6">
    <h1 class="text-2xl font-bold text-nvim-blue sm:text-3xl">Blog</h1>
    <p class="mt-1 text-nvim-gray">
      {blogPosts.length} post{blogPosts.length === 1 ? '' : 's'} on Neovim, Go, Linux and open source.
    </p>
  </header>

  <ul id="blog-list">
    {blogPosts.map((post, index) => (
      <li
        class="blog-item list-item mb-4 -mx-2 px-2 py-0.5 rounded-sm grid grid-cols-1 gap-1 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)_auto] sm:gap-4 items-start"
        data-index={index}
        data-href={`/blog/${post.id}`}
      >
        <a
          href={`/blog/${post.id}`}
          class="text-nvim-blue hover:underline font-semibold break-words min-w-0"
        >
          {post.data.title}
        </a>
        <div class="min-w-0">
          <p class="text-nvim-gray line-clamp-2">
            {post.data.summary}
          </p>
          {post.data.tags && (
            <p class="mt-1 text-xs text-nvim-blue/70 break-words">
              {post.data.tags.map((tag) => `#${tag}`).join('  ')}
            </p>
          )}
        </div>
        <time
          datetime={post.data.date.toISOString()}
          class="text-nvim-fg text-sm whitespace-nowrap sm:justify-self-end"
        >
          {post.data.date.toLocaleDateString('en-US', {year: 'numeric', month: 'short', day: 'numeric'})}
        </time>
      </li>
    ))}
  </ul>
</Layout>
