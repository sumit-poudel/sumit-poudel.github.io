---
import Sidebar from '../components/Sidebar.astro';
import StatusBar from '../components/StatusBar.astro';
import '../styles/global.css';
import { SITE } from '../consts';

export interface Props {
	title: string;
	description?: string;
	ogType?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	tags?: string[];
	authorName?: string;
	noindex?: boolean;
	schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title,
	description = SITE.tagline,
	ogType = 'website',
	publishedTime,
	modifiedTime,
	tags = [],
	authorName,
	noindex = false,
	schema,
} = Astro.props;

const siteName = SITE.name;
const site = Astro.site ?? new URL('https://www.sumit-poudel.com.np');
const canonical = new URL(Astro.url.pathname, site);
const socialImage = new URL(SITE.socialImage.path, site);
const isArticle = ogType === 'article';
const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const jsonLd = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const jsonLdPayload = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': jsonLd,
}).replace(/</g, '\\u003c');
---

<!DOCTYPE html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="2dJkm2g0l5EhkZLNHa3grjs1tmeESNN50j6ae0CQoNo" />
    <meta name="msvalidate.01" content="7936F3A4E88055B4873907438D7CC440" />
    <meta name="theme-color" content="#111111" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="apple-touch-icon" href="/logo.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.owner} — blog`} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Martian+Mono:wght@400..800&display=swap"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content={siteName} />
    <meta name="robots" content={robots} />
    <meta name="author" content={authorName ?? SITE.owner} />

    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(SITE.socialImage.width)} />
    <meta property="og:image:height" content={String(SITE.socialImage.height)} />
    <meta property="og:image:alt" content={SITE.socialImage.alt} />
    {isArticle && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {isArticle && (
      <meta property="article:modified_time" content={(modifiedTime ?? publishedTime)?.toISOString()} />
    )}
    {isArticle && authorName && <meta property="article:author" content={authorName} />}
    {isArticle && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={SITE.socialImage.alt} />

    {jsonLd.length > 0 && (
      <script type="application/ld+json" set:html={jsonLdPayload} is:inline />
    )}
  </head>
  <body class="bg-nvim-bg text-nvim-fg font-mono flex flex-col h-dvh min-h-dvh overflow-hidden">
    <div class="flex flex-1 min-h-0 overflow-hidden">
      <Sidebar />
        <main class="flex-1 min-w-0 w-full overflow-y-auto overflow-x-hidden overscroll-contain p-3 sm:p-4">
          <slot />
        </main>
    </div>
    <div
      id="search-results"
      class="hidden fixed bottom-8 left-0 right-0 max-h-[60dvh] overflow-y-auto overflow-x-hidden overscroll-contain bg-nvim-statusline border-t border-nvim-blue"
    ></div>
    <StatusBar />
    <script src="../scripts/search.ts"></script>
    <script src="../scripts/navigation.ts"></script>
  </body>
</html>
